#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
IDI_MASTIXA ICON "../mastixa_manager.ico"
1 RT_MANIFEST "launcher.manifest"
IDD_PREREQUISITE DIALOGEX 0, 0, 344, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mastixa Manager — Προαπαιτούμενο"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "", IDC_EXPLANATION, 14, 12, 316, 128
    LTEXT "https://aka.ms/vc14/vc_redist.x64.exe", -1, 14, 145, 316, 16
    PUSHBUTTON "&Λήψη από Microsoft", IDC_DOWNLOAD, 14, 181, 118, 24
    DEFPUSHBUTTON "Έλεγχος &ξανά", IDC_RECHECK, 140, 181, 100, 24
    PUSHBUTTON "&Ακύρωση", IDCANCEL, 248, 181, 82, 24
END
1 VERSIONINFO
FILEVERSION 1,0,0,2
PRODUCTVERSION 1,0,0,2
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mastixa Manager\0"
            VALUE "FileDescription", "Mastixa Manager — launch prerequisite check\0"
            VALUE "FileVersion", "1.0.0-rc.2\0"
            VALUE "InternalName", "MastixaManager\0"
            VALUE "OriginalFilename", "MastixaManager.exe\0"
            VALUE "ProductName", "Mastixa Manager\0"
            VALUE "ProductVersion", "1.0.0-rc.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
